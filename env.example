# DATABASE CONFIGURATION
DB_HOST=postgres
DB_PORT=5432
DB_NAME=databot
DB_USER=postgres
DB_PASSWORD=postgres

# APPLICATION CONFIGURATION
APP_NAME=DataBot API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# OPENAI CONFIGURATION
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# MCP SERVER CONFIGURATION
MCP_SERVER_NAME=databot-mcp-server
MCP_SERVER_VERSION=1.0.0

# Tool Configuration
MCP_MAX_TOOLS_PER_REQUEST=50
MCP_DEFAULT_TOOL_TIMEOUT=30

# Logging Configuration
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Request Configuration
MCP_MAX_CONCURRENT_REQUESTS=100
MCP_REQUEST_TIMEOUT=60

# AI Configuration
MCP_ENABLE_AI_INSIGHTS=true
MCP_AI_MODEL_TIMEOUT=30

# FRONTEND CONFIGURATION
BACKEND_URL=http://localhost:8000
